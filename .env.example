# Example environment variables for Tokenomicon integration tests.
# Copy to .env and fill in your own keys. Never commit .env itself.

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEST_MODEL=gpt-5.6-luna

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_TEST_MODEL=openai/gpt-oss-20b:free

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_TEST_MODEL=claude-haiku-4-5-20251001

GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_TEST_MODEL=gemini-3.5-flash

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_TEST_MODEL=deepseek-v4-flash

MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_TEST_MODEL=ministral-3b-latest
